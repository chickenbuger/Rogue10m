# Visual Studio 2015 user specific files
.vs/

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# Precompiled Assets
SourceArt/**/*.png
SourceArt/**/*.tga

# Binary Files
Binaries/*
Plugins/**/Binaries/*

# Builds
Build/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!Build/**/*.ico

# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
Saved/*

# Compiled source files for the engine to use
Intermediate/*
Plugins/**/Intermediate/*

# Cache files for the editor to use
DerivedDataCache/*

# Python bytecode/cache generated by Unreal Editor automation scripts
__pycache__/
*.py[cod]
# Local Python environments
.venv/

# Local Obsidian application state
.obsidian/

# Reproducible labeled video frames; keep source captures and generators
/tmp/boxing-direct/labeled/frame_*.png
/tmp/boxing-direct/labeled-lookdown40/frame_*.png
/tmp/boxing-reference/labeled-boxing/frame_*.png
/tmp/boxing-reference/labeled-longguard/frame_*.png
/tmp/boxing-reference/labeled-rooted/frame_*.png
/tmp/fullbody/labeled/frame_*.png
/tmp/head-camera/labeled/frame_*.png
/tmp/head-framing/labeled-forward30/frame_*.png
/tmp/martelo-game/labeled/frame_*.png
/tmp/relaxed-idle/labeled/frame_*.png

# Local work outputs; retain only inputs used by committed authoring tools
/tmp/**
!/tmp/imagegen/
!/tmp/imagegen/gothic_hud_layout_refinement/
!/tmp/imagegen/gothic_hud_layout_refinement/slot_wings_alpha.png
!/tmp/imagegen/gothic_hud_layout_refinement/slot_wings_chroma.png
!/tmp/martelo-game/
!/tmp/martelo-game/source_martelo_bind.fbx
!/tmp/martelo-game/source_bind_proxy.cpp
!/tmp/martelo-game/source_build.cmd

# Empty local Obsidian scratch canvas
/무제.canvas
