  "rules": {
    "jobAcquisitionKorean": "해당 무기를 직접 장착하면 직업을 얻는다. 전문가 연속 의뢰 완료를 직업·보스 입장 허가로 사용하지 않는다.",
    "starterWeaponPolicyKorean": "공통 기초 무기 접근과 특정 무기의 현장 획득은 별개다.",
    "skillSlotPolicy": {
      "mode": "weapon_specific_optional",
      "descriptionKorean": "동시클릭·차징 기술을 모든 무기에 일반화하지 않는다. 기술별 정상 장착 정책을 따르며 모든 무기에 해당 입력을 강제로 채우지 않는다."
    },
    "learning": {
      "normalPrerequisitesRequired": true,
      "requiredAllMeansAll": true,
      "autoLearn": false,
      "autoEquip": false,
      "consumeOnSuccessOnly": true,
      "conditionFailurePreservesBook": true,
      "descriptionKorean": "비급 획득과 학습·장착은 별개다. 정상 무기·숙련·선행·자원 조건을 모두 검사하고, 성공했을 때만 책을 소비한다."
    },
    "fieldBooks": {
      "contentsPolicy": "fixed",
      "midOrHighNpcCompletionChoice": false,
      "descriptionKorean": "중·상급 비급은 의뢰 현장의 고정함·기록·유품에서 직접 발견한다. NPC 완료창 지급·선택 보상으로 다시 주지 않는다. 현재 표는 고정 배치이며 사전 시드 후보군은 향후 명시 결정이 있을 때만 도입한다."
    },
    "beginnerTraining": {
      "allowed": true,
      "rewardBooks": [
        "stageplan.book.knuckle.k01",
        "stageplan.book.greatsword.g01",
        "stageplan.book.mage.magic_missile"
      ],
      "descriptionKorean": "각 우선 직업의 첫 초급 수련 보수만 명시한다. 붕권은 무건의 두 번째 수련 보상이 아니라 뿌리숲 유품 획득이다."
    },
    "optionalDropsKorean": "추가 확률 드롭은 별도 후속 설계다. 이 표의 고정 비급·필수 의뢰 물품을 확률 드롭으로 대체하지 않는다.",
    "duplicates": {
      "forceForget": false,
      "mandatoryCrafting": false,
      "autoConvert": false,
      "descriptionKorean": "이미 배운 책은 강제 망각·합성 없이 보관·매각·선택 교환할 수 있다. 자동 판매·변환하지 않는다."
    },
    "persistence": {
      "runLocal": [
        "특정 무기",
        "보유 비급",
        "숙련",
        "배운 기술",
        "장착",
        "이번 런 주문 페널티"
      ],
      "discoveryRecordTrigger": "actual_successful_learning",
      "permanentDiscoveryInfoOnly": true,
      "descriptionKorean": "Discovery는 최초 실제 학습 뒤 공개한 정보만 영구 보존한다. 책을 줍는 것만으로 기록을 완료하거나 다음 런 자동학습·영구사용권·조건 우회를 허용하지 않는다."
    },
    "resourcesKorean": "무기·비급 획득이 내공·투지·마나의 일괄 해금은 아니다. 허용 계열과 정상 RequiredAll·조합 호환성을 지키며 미정 자원·랭크·손실 수치를 새로 확정하지 않는다.",
    "routeFreedomKorean": "어느 전문가·마을·의뢰·중간보스도 최종보스 입장 조건이 아니다. 모든 비급을 한 런에 순회할 필요가 없으며 보상 기술을 이미 써야 그 비급을 얻는 역전 조건은 금지한다."
  },
